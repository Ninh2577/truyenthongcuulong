<IfModule mod_rewrite.c>

    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Block access to hidden files and directories (e.g. .git, .env)
    RewriteCond %{REQUEST_URI} "!(^|/)\.well-known([^./]+)?/" [NC]
    RewriteRule "(^|/)\." - [F]

    # Block automated WordPress exploit probes & vulnerability scanners
    RewriteCond %{REQUEST_URI} (wp-login\.php|xmlrpc\.php|wp-config\.php|wp-admin|wp-content|wp-includes|wp-trackback\.php) [NC]
    RewriteRule ^ - [F,L]

    # 1. Điều hướng /storage/ vào storage/app/public/ (Chống lặp vô tận vòng lặp 500)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} !^/storage/app/public/
    RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]

    # 2. Điều hướng tài nguyên tĩnh /vendor/ vào public/vendor/ (TinyMCE, Filemanager)
    RewriteRule ^vendor/(.*)$ public/vendor/$1 [L]

    # 3. Điều hướng tài nguyên tĩnh /images/ vào public/images/
    RewriteRule ^images/(.*)$ public/images/$1 [L]

    # Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve existing files/directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Laravel Front Controller
    RewriteRule ^ index.php [L]

</IfModule>

# Protect sensitive files, databases, logs, and config dumps
<FilesMatch "(\.(env|sql|bak|log|phar|xml|csv|sqlite|md)|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# Protect environment file
<Files ".env">
    Require all denied
</Files>
